ASTERION_APP_ENV=development
ASTERION_APP_HOST=0.0.0.0
ASTERION_APP_PORT=8000

ASTERION_DATABASE_URL=postgresql+asyncpg://asterion:asterion@localhost:5432/asterion
ASTERION_REDIS_URL=redis://localhost:6379/0

# O bot fica desligado até existir um token válido do BotFather.
ASTERION_TELEGRAM_BOT_ENABLED=false
ASTERION_TELEGRAM_BOT_TOKEN=
ASTERION_TELEGRAM_MODE=polling

# Obrigatório quando TELEGRAM_MODE=webhook e o bot estiver habilitado.
ASTERION_TELEGRAM_WEBHOOK_SECRET=
