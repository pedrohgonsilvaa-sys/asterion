ASTERION_APP_ENV=development
ASTERION_APP_HOST=0.0.0.0
ASTERION_APP_PORT=8000

ASTERION_DATABASE_URL=postgresql+asyncpg://asterion:asterion@localhost:5432/asterion
ASTERION_REDIS_URL=redis://localhost:6379/0

# Identidade do servidor controlada pelo backend, nunca por callback/chat/dispositivo.
ASTERION_SERVER_ID=asterion
# Política editorial fornecida pela operação, comparação case-insensitive (JSON).
ASTERION_BLOCKED_CHARACTER_NAMES=[]
# Mapa JSON: tela -> file_id oficial do Telegram ou file:caminho/do/asset.png.
# Sem asset, a tela usa somente texto + inline keyboard.
ASTERION_CREATION_IMAGES={}

# O bot fica desligado até existir um token válido do BotFather.
ASTERION_TELEGRAM_BOT_ENABLED=false
ASTERION_CONTRACTS_ENABLED=false
ASTERION_TELEGRAM_BOT_TOKEN=
ASTERION_TELEGRAM_MODE=polling

# Obrigatório quando TELEGRAM_MODE=webhook e o bot estiver habilitado.
ASTERION_TELEGRAM_WEBHOOK_SECRET=

# Opcional: grupo da Comunidade e tópico Mercado para o botão Divulgar Loja.
ASTERION_COMMUNITY_CHAT_ID=
ASTERION_COMMUNITY_MARKET_TOPIC_ID=
# Opcional: tópico Relatos do mesmo grupo, para o botão Compartilhar História.
ASTERION_COMMUNITY_RELATOS_TOPIC_ID=
# Opcional: link público de convite da Comunidade Oficial (botão do Menu Principal).
ASTERION_COMMUNITY_URL=

# Métricas e alertas da operação (B6). Não são regras de jogo.
# Porta do /metrics dentro do bot em polling; vazio = sem servidor de métricas.
ASTERION_METRICS_PORT=
# Se preenchido, /metrics exige o cabeçalho "Authorization: Bearer <token>".
ASTERION_METRICS_TOKEN=
# Chat do Telegram que recebe os alertas do operador; vazio = alertas desligados.
ASTERION_ALERT_CHAT_ID=
# Limites técnicos dos alertas (padrões abaixo).
ASTERION_ALERT_JOB_FAILURES=3
ASTERION_ALERT_OUTBOX_BACKLOG=500
ASTERION_ALERT_OUTBOX_AGE_SECONDS=1800
ASTERION_ALERT_COOLDOWN_SECONDS=1800

# Pagamentos (GDD §35): Patrono e Passe da Crônica pelo checkout da InfinitePay.
# Sem HANDLE, PUBLIC_URL e WEBHOOK_TOKEN a loja fica fechada.
# InfiniteTag sem o "$".
ASTERION_INFINITEPAY_HANDLE=
# Segredo, opcional: permite expirar o link e limitar a um pagamento por link.
ASTERION_INFINITEPAY_API_KEY=
# Endereço público HTTPS da API (o Caddy serve este domínio).
ASTERION_PAYMENTS_PUBLIC_URL=
# Só o domínio, sem https://, usado pelo Caddy no docker-compose.prod.yml.
ASTERION_PAYMENTS_DOMAIN=
# Segredo, 24+ caracteres aleatórios: vai na URL do webhook.
ASTERION_PAYMENTS_WEBHOOK_TOKEN=
# Preços em centavos (configuração comercial, mínimo 100). Vazio = não vende.
# Proposta do autor, a confirmar: Patrono 1490 e Passe 2490.
ASTERION_PATRON_PRICE_CENTS=
ASTERION_CHRONICLE_PASS_PRICE_CENTS=
# Validade do link de pagamento, em minutos.
ASTERION_PAYMENT_LINK_MINUTES=60
